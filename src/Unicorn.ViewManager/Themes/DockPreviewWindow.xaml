<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Unicorn.ViewManager">

    <Style TargetType="{x:Type vm:DockPreviewWindow}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type vm:DockPreviewWindow}">
                    <Canvas>
                        <Grid
                            x:Name="DockPreviewGrid"
                            Width="{TemplateBinding FrameworkElement.Width}"
                            Height="{TemplateBinding FrameworkElement.Height}"
                            Opacity="0.3"
                            ZIndex="1">
                            <Border
                                x:Name="PreviewBorder"
                                Background="{StaticResource {x:Static SystemColors.HotTrackBrushKey}}"
                                BorderBrush="{StaticResource {x:Static SystemColors.GrayTextBrushKey}}"
                                BorderThickness="5" />
                            <Canvas x:Name="InsertMarkerLayer" Visibility="Collapsed">
                                <Border
                                    x:Name="InsertMarker"
                                    Canvas.Left="{TemplateBinding InsertMarkerLeft}"
                                    Canvas.Top="{TemplateBinding InsertMarkerTop}"
                                    Width="{TemplateBinding InsertMarkerWidth}"
                                    Height="{TemplateBinding InsertMarkerHeight}"
                                    Background="#FFF59E0B"
                                    BorderBrush="#FFFFFFFF"
                                    BorderThickness="2"
                                    CornerRadius="2"
                                    Opacity="0.95" />
                            </Canvas>
                        </Grid>
                    </Canvas>
                    <ControlTemplate.Triggers>
                        <Trigger Property="PreviewDockDirection" Value="Fill">
                            <Setter TargetName="DockPreviewGrid" Property="Opacity" Value="0.18" />
                            <Setter TargetName="PreviewBorder" Property="BorderThickness" Value="3" />
                        </Trigger>
                        <Trigger Property="PreviewDockTargetType" Value="Outside">
                            <Setter TargetName="DockPreviewGrid" Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="PreviewDockTargetType" Value="Center">
                            <Setter TargetName="PreviewBorder" Property="BorderBrush" Value="{StaticResource {x:Static SystemColors.HighlightBrushKey}}" />
                        </Trigger>
                        <Trigger Property="PreviewIsTabInsert" Value="True">
                            <Setter TargetName="DockPreviewGrid" Property="Opacity" Value="0.24" />
                            <Setter TargetName="PreviewBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="InsertMarkerLayer" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
